---
const finds = ['Useful Desk Products', 'Travel Gadgets Worth Carrying', 'Kitchen Tools That Save Time'];
---

<section class="home-section home-section--muted" aria-labelledby="finds-heading">
  <div class="container"><div class="section-heading"><h2 id="finds-heading">Useful Finds</h2><p>Practical products and everyday recommendations selected to make buying decisions easier.</p></div>
    <div class="content-grid content-grid--three">{finds.map((find) => <article class="content-card"><p class="card-eyebrow">Smart Living</p><h3><a href="#finds-heading">{find}</a></h3><a class="card-link" href="#finds-heading">See recommendation <span aria-hidden="true">→</span></a></article>)}</div>
    <p class="section-disclosure">Some links may be affiliate links. We may earn a commission at no extra cost to you.</p>
  </div>
</section>
