---
const articles = ['How to Stop Procrastinating and Start Taking Action', 'How to Build Discipline When Motivation Fades', 'Daily Habits for a More Productive Life'];
---

<section class="home-section" aria-labelledby="mindset-heading">
  <div class="container"><div class="section-heading"><h2 id="mindset-heading">Mindset & Growth</h2></div>
    <div class="content-grid content-grid--three">{articles.map((article) => <article class="content-card"><p class="card-eyebrow">Mindset & Growth</p><h3><a href="#mindset-heading">{article}</a></h3><a class="card-link" href="#mindset-heading">Read article <span aria-hidden="true">→</span></a></article>)}</div>
  </div>
</section>
