---
interface Article {
  title: string;
  category: string;
  href: string;
}

interface Props {
  articles?: Article[];
}

const { articles = [] } = Astro.props;
---

{articles && articles.length > 0 && (
  <section class="home-section home-section--mindset" aria-labelledby="mindset-heading">
    <div class="container">
      <div class="section-heading">
        <h2 id="mindset-heading">Mindset & Growth</h2>
      </div>
      <div class="content-grid content-grid--three">
        {articles.map((article) => (
          <article class="content-card">
            <p class="card-eyebrow">{article.category}</p>
            <h3><a href={article.href}>{article.title}</a></h3>
            <a class="card-link" href={article.href}>
              Read article <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
