---
const guides = ['ChatGPT vs Gemini', 'Best Productivity Apps for Freelancers', 'Smart Home Devices for Beginners'];
---

<section class="home-section" aria-labelledby="trending-heading">
  <div class="container"><div class="section-heading"><h2 id="trending-heading">Trending Guides</h2></div>
    <div class="content-grid content-grid--three">{guides.map((guide) => <article class="content-card"><p class="card-eyebrow">Popular guide</p><h3><a href="#trending-heading">{guide}</a></h3><a class="card-link" href="#trending-heading">Read guide <span aria-hidden="true">→</span></a></article>)}</div>
  </div>
</section>
