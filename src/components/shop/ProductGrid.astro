---
import ProductCard from './ProductCard.astro';

interface Product {
  title: string;
  description: string;
  price: string;
  href: string;
  visualVariant?: number;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="product-grid">
  {
    products.map((product, index) => (
      <ProductCard
        {...product}
        visualVariant={product.visualVariant ?? (index % 3) + 1}
      />
    ))
  }
</div>