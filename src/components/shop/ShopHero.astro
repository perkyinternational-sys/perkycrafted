---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const {
  eyebrow,
  title,
  description,
} = Astro.props;
---

<header class="shop-hero">
  <div class="container shop-hero__inner">
    <p class="section-eyebrow">
      {eyebrow}
    </p>

    <h1>
      {title}
    </h1>

    <p>
      {description}
    </p>

    <div class="shop-hero__accent" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
  </div>
</header>