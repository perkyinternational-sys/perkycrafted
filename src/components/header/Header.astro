---
import DesktopNav from './DesktopNav.astro';
import MobileNav from './MobileNav.astro';
import '../../styles/header.css';
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/" aria-label="Perky Crafted home">PERKY CRAFTED</a>
    <DesktopNav />
    <div class="site-header__actions">
      <button class="header-icon-button" type="button" aria-label="Search">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
          <circle cx="11" cy="11" r="6" />
          <path d="m16 16 4 4" />
        </svg>
      </button>
      <a class="site-header__shop" href="/shop/">Shop</a>
      <MobileNav />
    </div>
  </div>
</header>
