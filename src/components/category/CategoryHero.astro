---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="category-hero">
  <div class="container category-hero__inner">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
    <div class="category-hero__content"><p class="section-eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p></div>
    <div class="category-hero__accent" aria-hidden="true"><span></span><span></span></div>
  </div>
</header>
