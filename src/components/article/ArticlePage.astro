---
import ArticleBody from './ArticleBody.astro'; import ArticleDisclosure from './ArticleDisclosure.astro'; import ArticleHeader from './ArticleHeader.astro'; import RelatedArticles from './RelatedArticles.astro'; import '../../styles/article.css';
interface RelatedArticle { category: string; title: string; href: string; visualVariant?: number; }
interface Props { category: string; categoryHref: string; title: string; description: string; publishedDate: string; updatedDate?: string; readingTime: string; author: string; featuredVisualVariant?: number; showAffiliateDisclosure?: boolean; relatedArticles: RelatedArticle[]; pageClass?: string; }
const { category, categoryHref, title, description, publishedDate, updatedDate, readingTime, author, featuredVisualVariant = 1, showAffiliateDisclosure = false, relatedArticles, pageClass = '' } = Astro.props;
---
<article class:list={['article-page', pageClass]}><div class="container article-page__container"><ArticleHeader category={category} categoryHref={categoryHref} title={title} description={description} publishedDate={publishedDate} updatedDate={updatedDate} readingTime={readingTime} author={author} /><div class={`article-featured-visual article-featured-visual--${featuredVisualVariant}`} aria-hidden="true"><span></span><span></span><span></span></div>{showAffiliateDisclosure && <ArticleDisclosure />}<ArticleBody><slot /></ArticleBody><RelatedArticles articles={relatedArticles} /><aside class="article-newsletter" aria-labelledby="article-newsletter-heading"><div><h2 id="article-newsletter-heading">Get useful ideas from Perky Crafted</h2><p>Practical guides, resources and recommendations delivered occasionally.</p></div><a href="/#newsletter">Join the Newsletter</a></aside></div></article>
