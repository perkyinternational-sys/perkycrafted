---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/category/CategoryPage.astro';

const rawArticles = await getCollection('articles', ({ data }) => {
  return data.category === 'AI & Digital' && data.draft !== true;
});

const featuredEntry = rawArticles.find((entry) => entry.data.featured === true);
const featuredArticle = featuredEntry
  ? {
      title: featuredEntry.data.title,
      excerpt: featuredEntry.data.description,
      href: `/articles/${featuredEntry.id}/`,
    }
  : undefined;

const regularEntries = featuredEntry
  ? rawArticles.filter((entry) => entry.id !== featuredEntry.id)
  : rawArticles;

const articles = regularEntries.map((entry) => ({
  title: entry.data.title,
  excerpt: entry.data.description,
  href: `/articles/${entry.id}/`,
  badge: entry.data.tags?.[0],
}));
---

<BaseLayout
  title="AI & Digital | Perky Crafted"
  description="Explore practical AI tools, useful apps, software guides and digital recommendations from Perky Crafted."
>
  <CategoryPage
    eyebrow="EXPLORE"
    title="AI & Digital"
    description="Practical AI tools, useful apps, software guides and digital ideas to help you work smarter and make better technology choices."
    featuredArticle={featuredArticle}
    articles={articles}
    pageClass="category-page--ai-digital"
  />
</BaseLayout>
