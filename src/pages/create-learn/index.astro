---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/category/CategoryPage.astro';

const rawArticles = await getCollection('articles', ({ data }) => {
  return data.category === 'Create & Learn' && data.draft !== true;
});

const featuredEntry = rawArticles.find((entry) => entry.data.featured === true);
const featuredArticle = featuredEntry
  ? {
      title: featuredEntry.data.title,
      excerpt: featuredEntry.data.description,
      href: `/articles/${featuredEntry.id}/`,
    }
  : undefined;

const regularEntries = featuredEntry
  ? rawArticles.filter((entry) => entry.id !== featuredEntry.id)
  : rawArticles;

const articles = regularEntries.map((entry) => ({
  title: entry.data.title,
  excerpt: entry.data.description,
  href: `/articles/${entry.id}/`,
  badge: entry.data.tags?.[0],
}));
---

<BaseLayout
  title="Create & Learn | Perky Crafted"
  description="Practical resources, creator tools, templates and learning ideas for students, creators and independent professionals."
>
  <CategoryPage
    eyebrow="EXPLORE"
    title="Create & Learn"
    description="Practical resources, creator tools, templates and learning ideas for students, creators and independent professionals."
    featuredArticle={featuredArticle}
    articles={articles}
    pageClass="category-page--create-learn"
  />
</BaseLayout>
