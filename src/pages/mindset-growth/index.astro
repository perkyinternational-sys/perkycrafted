---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/category/CategoryPage.astro';
const articles = ['How to Build Discipline When Motivation Fades', 'Daily Habits for a More Productive Life', 'How Students Can Stay Motivated During Exams', 'Simple Ways to Improve Focus', 'Building Better Daily Routines', 'Small Habits That Compound Over Time'].map((title) => ({ title }));
---
